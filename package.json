{
  "name": "rufflo-agent-fleet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "eval:quality": "promptfoo eval -c promptfooconfig.yaml",
    "self-healer": "tsx scripts/test-objective.ts",
    "test:objective": "tsx scripts/test-objective.ts",
    "test:memory": "tsx --test tests/memory-store.test.ts",
    "test:chat-format": "tsx --test tests/chat-format.test.ts",
    "test": "tsx -e \"import { runSecurityTestSuite } from './tests/command03.test.ts'; runSecurityTestSuite().then(r => { console.log(JSON.stringify(r, null, 2)); if (!r.passed) process.exit(1); }).catch(e => { console.error(e); process.exit(1); })\""
  },
  "dependencies": {
    "@composio/core": "^0.18.0",
    "@google-cloud/kms": "5.7.0",
    "@google/genai": "^2.4.0",
    "@langfuse/otel": "6.0.1",
    "@langfuse/tracing": "6.0.1",
    "@mastra/core": "^1.63.2",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "10.14.1",
    "helmet": "^8.0.0",
    "inngest": "4.25.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/diff": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "promptfoo": "0.124.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
