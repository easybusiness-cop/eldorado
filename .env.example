# Required for real AI generation (Gemini)
GEMINI_API_KEY=""

# Development auth bypass
RUFFLO_DEV_AUTH="true"

# Public API / GitHub
GITHUB_TOKEN=""

# OpenTelemetry for tracing
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"

APP_URL="http://localhost:3000"
COMPOSIO_API_KEY=""

# Open WebUI Integration (Active & Connected)
OPEN_WEBUI_URL="http://localhost:8080"
OPEN_WEBUI_API_KEY=""

# Public browser configuration — safe to expose.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration — never expose in React or VITE_ variables.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# RDIWI production encryption. Grant the server workload identity
# roles/cloudkms.cryptoKeyEncrypterDecrypter on this symmetric key.
RUFFLO_KMS_KEY_NAME="projects/your-project/locations/us/keyRings/rufflo/cryptoKeys/agent-secrets"

# Google Workspace OAuth web client. The redirect URI must exactly match the
# URI registered in Google Cloud: {APP_URL}/api/identity/google/callback.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/identity/google/callback"
GOOGLE_WORKSPACE_DOMAIN="example.com"

# Organization for Rufflo's internal, tenantless background research agent.
RUFFLO_SYSTEM_ORGANIZATION_ID="org-default"

# Optional – Local Ollama (fully independent)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_API_KEY=""

# Optional – Telegram Bot API Token (free open-source integration)
TELEGRAM_BOT_TOKEN=""

# Engineering coding runtimes. The default is used when an agent does not
# select one explicitly. Tasks run in disposable Git clones and return a diff;
# runtime completion is not treated as correctness verification.
RUFFLO_CODING_ENGINE_DEFAULT="openhands"
RUFFLO_CODING_REPOSITORY_ROOT=""

# OpenHands Agent Server 1.55.1. Run the outer server with Docker conversation
# runtime so every conversation gets its own sandbox container. Keep the API
# URL private and use a stable API key plus OH_SECRET_KEY on that server.
OPENHANDS_AGENT_SERVER_URL="http://openhands-agent:8000"
OPENHANDS_SESSION_API_KEY=""
OPENHANDS_WORKSPACE_HOST_ROOT="/rufflo-workspaces"
OPENHANDS_WORKSPACE_ROOT="/rufflo-workspaces"
OPENHANDS_WORKSPACE_ISOLATION="per-task-container"
OPENHANDS_MODEL="google/gemini-2.5-flash"
OPENHANDS_LLM_API_KEY=""
OPENHANDS_LLM_BASE_URL=""
OPENHANDS_MAX_ITERATIONS="100"

# OpenCode 1.19.4 runs in a new disposable worker container per task.
# Build the image with: docker build -t rufflo/opencode-worker:1.19.4 workers/opencode
OPENCODE_WORKSPACE_ROOT="/rufflo-workspaces"
OPENCODE_WORKSPACE_ISOLATION="per-task-container"
OPENCODE_WORKER_IMAGE="rufflo/opencode-worker:1.19.4"
OPENCODE_DOCKER_NETWORK="rufflo-model-egress"
OPENCODE_MODEL=""
OPENCODE_PROVIDER_API_KEY=""
OPENCODE_CONTAINER_MEMORY="4g"
OPENCODE_CONTAINER_CPUS="2"
OPENCODE_CONTAINER_PIDS_LIMIT="256"

# Exact origins authorized for non-interactive Playwright browser inspections.
# Use a comma-separated list, for example: https://staging.example.com
RUFFLO_BROWSER_ALLOWED_ORIGINS=""
