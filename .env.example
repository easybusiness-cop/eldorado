# GEMINI_API_KEY: Required for Gemini AI API calls and Mastra Model Routing.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# COMPOSIO_API_KEY: Optional. Unlocks Composio 1000+ SaaS toolkits & authenticated app integrations.
COMPOSIO_API_KEY=""

# GITHUB_TOKEN: Optional. Personal Access Token or OAuth token for GitHub VCS repository operations.
GITHUB_TOKEN=""

# Supabase Credentials: Required for the persistent database backend.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
